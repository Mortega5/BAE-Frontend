  "narrative": {
    "northStar": "The Themed Marketplace",
    "overview": "One neutral, token-driven shell that rebrands per tenant. The structure never changes between BAE, DOME and any future theme; only the brand roles do. Every color in a template is a role, never a literal.",
    "keyCharacteristics": [
      "Roles over literals: text-content, bg-surface, border-line, text-on-primary; no dark: variants on roles.",
      "Two brand colors per theme (a deep primary and a brighter sibling) plus a tinted secondary ramp.",
      "Light and dark are first-class; dark drops the tenant tint from inputs in favor of one neutral slate.",
      "Shared components own their styling; pages compose them."
    ],
    "rules": [
      { "name": "The Role Rule", "body": "Templates carry class names only. No Tailwind palette colors, no hex, no var() in HTML.", "section": "colors" },
      { "name": "The One Source Rule", "body": "A shared component's colors are CSS variables in src/styles.css, never hardcoded in its own scss.", "section": "colors" },
      { "name": "The Tint Not Swap Rule", "body": "Hover, selected and info surfaces are derived from the primary with color-mix() or alpha.", "section": "colors" },
      { "name": "The One Family Rule", "body": "Blinker everywhere; change the family through the theme font variables.", "section": "typography" },
      { "name": "The Flat-At-Rest Rule", "body": "Surfaces are flat until hovered, opened or floating.", "section": "elevation" }
    ],
    "dos": [
      "Do pick a role class and omit dark: variants.",
      "Do reach for an existing shared component before styling markup by hand.",
      "Do define new component colors as CSS variables in src/styles.css.",
      "Do give every new i18n key a real Spanish translation.",
      "Do keep primary-colored surfaces to action and selection; status colors for status only."
    ],
    "donts": [
      "Don't use Tailwind palette colors, hex or rgb() in templates or component stylesheets.",
      "Don't write text-[var(--x)] or inline var() in HTML.",
      "Don't hardcode a shared component's colors in its own scss.",
      "Don't bind title, id or hidden as plain attributes on a custom component.",
      "Don't add shadows at rest to cards."
